#!/bin/bash
# Cleanly restart the quickshell bar/dock/panels.
pkill -x qs
sleep 0.2
QS_ICON_THEME=Adwaita setsid -f qs -p "$HOME/.config/quickshell" >/dev/null 2>&1
sleep 1
pgrep -x qs >/dev/null && echo "quickshell restarted" || echo "quickshell FAILED to start — run: qs -p ~/.config/quickshell" >&2
